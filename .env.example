# Copy this file to .env and edit it. The .env file is git-ignored,
# so your API key never gets pushed to GitHub.

# Which LLM writes the answer: ollama (local PC), api (hosted), or off
LLM_PROVIDER=ollama

# Option 1: Ollama running on this PC
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Option 2: any OpenAI-compatible API
LLM_API_BASE=https://api.openai.com/v1
LLM_API_MODEL=gpt-4o-mini
LLM_API_KEY=

# Other providers use the same format, for example:
#   Groq        LLM_API_BASE=https://api.groq.com/openai/v1
#   OpenRouter  LLM_API_BASE=https://openrouter.ai/api/v1
